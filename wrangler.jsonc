{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nahan",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a75c7f0e-bf62-4b26-8c4a-a2bc131806dc","database_name": "nahan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b208f07015a74ded9054b089e6e37b93" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
